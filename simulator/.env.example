# =========================================================================
# ALERTAJÁ - Configurações do Simulador de Sensores IoT
# AMBIENTE ACADÊMICO / SIMULADO - DADOS FICTÍCIOS
# =========================================================================

# URL base da API REST do AlertaJá
API_BASE_URL=http://localhost:8080

# Chave secreta de autenticação para o cabeçalho X-Sensor-API-Key
# Deve coincidir exatamente com a variável SENSOR_INGESTION_API_KEY configurada no backend
SENSOR_INGESTION_API_KEY=informe_aqui_sua_chave_de_telemetria

# Intervalo entre envios de medições na simulação contínua (em segundos)
SIMULATION_INTERVAL_SECONDS=2.0

# Opcional: Credenciais de administrador para bootstrap automático de regiões/sensores
ADMIN_EMAIL=admin@alertaja.com
ADMIN_PASSWORD=Admin@123456
